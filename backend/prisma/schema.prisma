generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}


datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  googleId     String?   @unique
  role         String    @default("Member")
  avatarUrl    String?
  avatarColor  String?   @default("#2563EB")
  projects     Project[] @relation("ProjectMembers")
  ownedProjects Project[] @relation("ProjectOwner")
  assignedTasks Task[]   @relation("TaskAssignee")
  sentInvitations     ProjectInvitation[] @relation("InvitationInviter")
  receivedInvitations ProjectInvitation[] @relation("InvitationInvitee")
  createdAt    DateTime  @default(now())
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#2563EB")
  tasks     Task[]
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([name, projectId])
}

model Project {
  id          String    @id @default(uuid())
  name        String
  colorCode   String?   @default("#2563EB")
  ownerId     String?
  owner       User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     User[]    @relation("ProjectMembers")
  tasks       Task[]
  tags        Tag[]
  invitations ProjectInvitation[]
  createdAt   DateTime  @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?   @default("")
  status      String    @default("TO_DO")
  tags        Tag[]
  priority    String?   @default("Medium")
  dueDate     DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model ProjectInvitation {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    User     @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId  String
  invitee    User     @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt  DateTime @default(now())
}